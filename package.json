{
  "name": "switch-launcher",
  "version": "1.0.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p electron/tsconfig.json",
    "electron:dev": "concurrently -k \"vite\" \"tsc -p electron/tsconfig.json -w\" \"wait-on http://localhost:5173 dist-electron/main.js && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.tsubasaxyuki.switchlauncher",
    "productName": "Switch Launcher",
    "files": [
      "dist",
      "dist-electron"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Switch Launcher",
      "artifactName": "Switch Launcher Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "Switch Launcher ${version} portable.${ext}"
    }
  },
  "description": "Launcher estilo menú HOME de Nintendo Switch para tus juegos de Switch en emuladores",
  "author": "tsubasaxyuki"
}